# ── Authentication (Clerk) ──────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Database (Supabase) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI / LLM (Groq) ────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key
# Get free key at: https://console.groq.com

# ── Maps (Mapbox) ───────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1your_mapbox_token
# Get free token at: https://account.mapbox.com

# ── Python ML Service (optional — app works without it) ─
NEXT_PUBLIC_ML_URL=http://localhost:8000
# Only needed when running the full Python ML backend locally

# ── Error Tracking (Sentry) ─────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project
# Optional — app works without Sentry

# ── Free/No-key APIs (auto-configured, no setup needed) ─
# Open-Meteo    — https://api.open-meteo.com  (weather, no key needed)
# Google News   — RSS feed (no key needed)
# OpenStreetMap — Overpass API (no key needed)
# Agmarknet     — Indian mandi prices (no key needed)
