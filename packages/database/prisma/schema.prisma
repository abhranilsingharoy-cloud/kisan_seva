// ============================================================
// AGRI ADVISORY — Prisma Schema
// PostgreSQL database for Smart Crop Advisory System
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────

enum UserRole {
  FARMER
  EXTENSION_WORKER
  FPO_STAFF
  AGRONOMIST
  ADMIN
}

enum AuthProvider {
  EMAIL
  PHONE_OTP
  GOOGLE
}

model User {
  id             String       @id @default(cuid())
  phone          String?      @unique
  email          String?      @unique
  name           String
  role           UserRole     @default(FARMER)
  language       String       @default("en")    // BCP47 language tag
  authProvider   AuthProvider @default(PHONE_OTP)
  avatarUrl      String?
  isVerified     Boolean      @default(false)
  isActive       Boolean      @default(true)
  lowDataMode    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  farms            Farm[]
  diagnoses        Diagnosis[]
  priceAlerts      PriceAlert[]
  notifications    Notification[]
  sessions         Session[]
  fpoMembership    FpoMember?

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// ─────────────────────────────────────────
// FARMS & PLOTS
// ─────────────────────────────────────────

enum SoilType {
  LOAMY
  CLAY
  SANDY
  SILTY
  PEATY
  CHALKY
  UNKNOWN
}

enum IrrigationType {
  DRIP
  SPRINKLER
  FLOOD
  FURROW
  RAINFED
}

model Farm {
  id             String  @id @default(cuid())
  userId         String
  name           String
  district       String
  state          String
  pincode        String?
  latitude       Float?
  longitude      Float?
  totalAreaAcres Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plots Plot[]

  @@index([userId])
  @@index([state, district])
  @@map("farms")
}

model Plot {
  id              String         @id @default(cuid())
  farmId          String
  name            String
  areaAcres       Float
  soilType        SoilType       @default(UNKNOWN)
  irrigationType  IrrigationType @default(RAINFED)
  latitude        Float?
  longitude      Float?
  currentCrop     String?
  cropSownDate    DateTime?
  cropStage       String?        // e.g., "vegetative", "flowering", "fruiting"
  soilHealthCardId String?       // SHC portal reference
  soilNitrogen    Float?         // kg/ha
  soilPhosphorus  Float?
  soilPotassium   Float?
  soilPH          Float?
  soilMoisture    Float?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  farm           Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  diagnoses      Diagnosis[]
  recommendations Recommendation[]
  schedules      IrrigationSchedule[]

  @@index([farmId])
  @@map("plots")
}

// ─────────────────────────────────────────
// CROP DISEASE DIAGNOSIS
// ─────────────────────────────────────────

enum DiagnosisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  ESCALATED        // Sent to human expert
}

enum DiagnosisFeedback {
  CONFIRMED
  REJECTED
  PARTIALLY_CORRECT
}

model Diagnosis {
  id              String            @id @default(cuid())
  userId          String
  plotId          String?
  imageUrl        String
  imageKey        String            // S3/storage object key
  cropName        String?
  status          DiagnosisStatus   @default(PENDING)
  
  // ML Results
  detectedDisease String?
  pestName        String?
  confidenceScore Float?
  severityLevel   String?           // "low", "moderate", "high", "critical"
  treatmentAdvice String?           // plain-language treatment
  treatmentAdviceHi String?         // Hindi treatment
  preventionTips  String?
  shouldEscalate  Boolean           @default(false)
  
  // Feedback loop
  farmerFeedback  DiagnosisFeedback?
  expertVerified  Boolean           @default(false)
  expertNotes     String?
  
  // IVR/SMS reference
  smsSessionId    String?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  plot   Plot?   @relation(fields: [plotId], references: [id])

  @@index([userId])
  @@index([plotId])
  @@index([status])
  @@map("diagnoses")
}

// ─────────────────────────────────────────
// RECOMMENDATIONS
// ─────────────────────────────────────────

enum RecommendationType {
  IRRIGATION
  FERTILIZER
  PEST_CONTROL
  WEATHER_ALERT
  MARKET_SELL
}

model Recommendation {
  id          String              @id @default(cuid())
  plotId      String
  type        RecommendationType
  title       String
  titleHi     String?             // Hindi
  body        String
  bodyHi      String?
  priority    String              @default("normal") // "low", "normal", "high", "urgent"
  actionLabel String?
  actionUrl   String?
  validUntil  DateTime?
  isRead      Boolean             @default(false)
  createdAt   DateTime            @default(now())

  plot Plot @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@index([plotId])
  @@map("recommendations")
}

model IrrigationSchedule {
  id             String   @id @default(cuid())
  plotId         String
  scheduledDate  DateTime
  waterAmountMM  Float
  durationMins   Int
  reason         String?
  weatherContext String?
  isCompleted    Boolean  @default(false)
  createdAt      DateTime @default(now())

  plot Plot @relation(fields: [plotId], references: [id], onDelete: Cascade)

  @@index([plotId, scheduledDate])
  @@map("irrigation_schedules")
}

// ─────────────────────────────────────────
// MARKET PRICES (Mandi)
// ─────────────────────────────────────────

model MandiPrice {
  id          String   @id @default(cuid())
  mandiName   String
  district    String
  state       String
  commodity   String
  variety     String?
  minPrice    Float    // INR per quintal
  maxPrice    Float
  modalPrice  Float
  priceDate   DateTime
  source      String   @default("agmarknet")
  fetchedAt   DateTime @default(now())

  @@index([commodity, state, priceDate])
  @@index([mandiName, priceDate])
  @@map("mandi_prices")
}

model PriceAlert {
  id          String   @id @default(cuid())
  userId      String
  commodity   String
  targetPrice Float
  alertType   String   // "above" | "below"
  isActive    Boolean  @default(true)
  lastTriggered DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("price_alerts")
}

// ─────────────────────────────────────────
// FPO (Farmer Producer Organizations)
// ─────────────────────────────────────────

model FarmerProducerOrg {
  id          String   @id @default(cuid())
  name        String
  regNumber   String?  @unique
  district    String
  state       String
  contactEmail String?
  contactPhone String?
  createdAt   DateTime @default(now())

  members FpoMember[]

  @@map("farmer_producer_orgs")
}

model FpoMember {
  id      String @id @default(cuid())
  userId  String @unique
  fpoId   String
  role    String @default("member") // "member" | "lead" | "admin"
  joinedAt DateTime @default(now())

  user User              @relation(fields: [userId], references: [id])
  fpo  FarmerProducerOrg @relation(fields: [fpoId], references: [id])

  @@map("fpo_members")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

enum NotificationChannel {
  PUSH
  SMS
  IVR
  IN_APP
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  title     String
  body      String
  data      Json?
  isRead    Boolean             @default(false)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────
// SMS / IVR INTERACTION LOG
// ─────────────────────────────────────────

model SmsIvrLog {
  id           String   @id @default(cuid())
  phone        String
  channel      String   // "sms" | "ivr"
  direction    String   // "inbound" | "outbound"
  message      String?
  intent       String?  // parsed intent: "price", "weather", "pest"
  responseText String?
  twilioSid    String?
  createdAt    DateTime @default(now())

  @@index([phone, createdAt])
  @@map("sms_ivr_logs")
}

// ─────────────────────────────────────────
// CROP KNOWLEDGE BASE (for SSG content)
// ─────────────────────────────────────────

model CropGuide {
  id           String   @id @default(cuid())
  slug         String   @unique
  cropName     String
  cropNameHi   String?
  family       String?
  season       String?
  description  String
  diseases     Json?    // array of { name, symptoms, treatment }
  pests        Json?
  nutritionReqs Json?
  waterReqs    String?
  publishedAt  DateTime?
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@map("crop_guides")
}
