# ============================================================
# KisanSeva — Web App Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to Git — it is already in .gitignore
#
# Live app is pre-configured on Vercel with all keys.
# You only need this file for local development.
# ============================================================

# ─── Auth (Clerk) ────────────────────────────────────────────
# Get keys at: https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Database (Supabase) ─────────────────────────────────────
# Get keys at: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── AI / LLM (Groq — Primary Agent) ────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key

# ─── AI Vision (Google Gemini — Disease Detection) ───────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ─── AI (NVIDIA NIM — Optional fallback) ─────────────────────
# Get key at: https://build.nvidia.com
NVIDIA_NIM_KEY=your_nvidia_nim_api_key

# ─── Maps (MapTiler) ─────────────────────────────────────────
# Get free key at: https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_api_key

# ─── Market Data (Agmarknet) ─────────────────────────────────
# Get key at: https://agmarknet.gov.in (Indian Govt API)
# Leave blank to use the public endpoint (rate-limited)
AGMARKNET_API_KEY=your_agmarknet_api_key

# ─── WhatsApp Business API (optional) ────────────────────────
# Get from: https://developers.facebook.com → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# ─── Python ML Service URL ───────────────────────────────────
# Local development: http://localhost:8000
# Production (localtunnel): https://your-tunnel.loca.lt
NEXT_PUBLIC_ML_URL=http://localhost:8000

# ─── App URL ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Error Tracking (Sentry — optional) ──────────────────────
# Get DSN at: https://sentry.io → Your Project → Settings → SDK Setup
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# ─── Free APIs (no key needed — auto-configured) ─────────────
# Open-Meteo    → https://api.open-meteo.com  (weather)
# OpenStreetMap → Overpass API               (cold storage finder)
# Google News   → RSS feed                   (krishi news)
# Agradoot Radio → Public HTTPS streams      (krishi radio)
